---
import "@fontsource-variable/inter/index.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/utilities.css";
import "../styles/components.css";
import "../styles/sections.css";

import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import Analytics from "@vercel/analytics/astro";

import Footer from "../components/layout/Footer.astro";
import Navbar from "../components/navigation/Navbar.astro";
import Breadcrumbs from "../components/navigation/Breadcrumbs.astro";
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TAGLINE,
  SITE_URL,
} from "../config/site";
import { serviceCategories } from "../data/services";
import type { FaqItem } from "../data/faq";
import type { BreadcrumbItem } from "../types/seo";

interface Props {
  /** Unique page title, 50–60 characters where possible. */
  title: string;
  /** Unique meta description, 140–160 characters where possible. */
  description: string;
  /** Social preview image path, relative to the site root. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Trail rendered above the page and emitted as BreadcrumbList. Omit on the home page. */
  breadcrumbs?: BreadcrumbItem[];
  /** Questions rendered on the page; emitted verbatim as FAQPage. */
  faq?: FaqItem[];
}

const {
  title,
  description,
  image = "/og-image.png",
  imageAlt = "Aurasoli — Make Your Move.",
  noindex = false,
  breadcrumbs,
  faq,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const socialImage = new URL(image, siteOrigin).href;

const organizationId = `${siteOrigin.origin}/#organization`;
const websiteId = `${siteOrigin.origin}/#website`;
const contactUrl = new URL("/contact", siteOrigin).href;

const organizationNode = {
  "@type": "ProfessionalService",
  "@id": organizationId,
  name: SITE_NAME,
  url: siteOrigin.origin,
  description: SITE_DESCRIPTION,
  slogan: SITE_TAGLINE,
  logo: {
    "@type": "ImageObject",
    url: new URL("/assets/logo/Aurasoli-icon.png", siteOrigin).href,
    width: 96,
    height: 96,
  },
  image: socialImage,
  knowsAbout: serviceCategories.map((category) => category.title),
  // The brand has no published email, phone, street address or social
  // profiles yet, so those properties stay out rather than being guessed.
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    url: contactUrl,
  },
};

const websiteNode = {
  "@type": "WebSite",
  "@id": websiteId,
  url: siteOrigin.origin,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  inLanguage: "en",
  publisher: { "@id": organizationId },
};

const serviceNodes = serviceCategories.map((category) => ({
  "@type": "Service",
  "@id": `${siteOrigin.origin}/services#${category.slug}`,
  name: category.title,
  serviceType: category.title,
  description: category.description,
  url: `${siteOrigin.origin}/services#${category.slug}`,
  provider: { "@id": organizationId },
  mainEntityOfPage: new URL("/services", siteOrigin).href,
}));

const breadcrumbNode = breadcrumbs?.length
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: new URL(item.path, siteOrigin).href,
      })),
    }
  : null;

const faqNode = faq?.length
  ? {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }
  : null;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organizationNode,
    websiteNode,
    ...serviceNodes,
    ...(breadcrumbNode ? [breadcrumbNode] : []),
    ...(faqNode ? [faqNode] : []),
  ],
};

const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0C0F" />
    <meta
      name="google-site-verification"
      content="wCzqv3MUpRBOcOMFub8esiAjyHfJOIzWU03OhVr2gqQ"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link
      rel="icon"
      type="image/png"
      href="/assets/logo/Aurasoli-icon.png"
      sizes="96x96"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href={interLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Navbar />
    <main id="main-content" tabindex="-1">
      {breadcrumbs?.length ? <Breadcrumbs items={breadcrumbs} /> : null}
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
