---
import "@fontsource-variable/inter/index.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/utilities.css";
import "../styles/components.css";
import "../styles/sections.css";

import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import Analytics from "@vercel/analytics/astro";

import Footer from "../components/layout/Footer.astro";
import Navbar from "../components/navigation/Navbar.astro";
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TAGLINE,
  SITE_URL,
} from "../config/site";
import { serviceCategories } from "../data/services";

interface Props {
  /** Unique page title, 50–60 characters where possible. */
  title: string;
  /** Unique meta description, 140–160 characters where possible. */
  description: string;
  /** Social preview image path, relative to the site root. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/og-image.png",
  imageAlt = "Aurasoli — Make Your Move.",
  noindex = false,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const socialImage = new URL(image, siteOrigin).href;

const organizationId = `${siteOrigin.origin}/#organization`;
const websiteId = `${siteOrigin.origin}/#website`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": organizationId,
      name: SITE_NAME,
      url: siteOrigin.origin,
      description: SITE_DESCRIPTION,
      slogan: SITE_TAGLINE,
      logo: {
        "@type": "ImageObject",
        url: new URL("/assets/logo/Aurasoli-icon.png", siteOrigin).href,
        width: 96,
        height: 96,
      },
      knowsAbout: serviceCategories.map((category) => category.title),
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteOrigin.origin,
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
      inLanguage: "en",
      publisher: { "@id": organizationId },
    },
  ],
};

const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0C0F" />
    <meta
      name="google-site-verification"
      content="wCzqv3MUpRBOcOMFub8esiAjyHfJOIzWU03OhVr2gqQ"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link
      rel="icon"
      type="image/png"
      href="/assets/logo/Aurasoli-icon.png"
      sizes="96x96"
    />
    <link
      rel="preload"
      href={interLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Navbar />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
