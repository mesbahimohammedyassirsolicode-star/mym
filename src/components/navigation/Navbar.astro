---
import { Image } from "astro:assets";
import { Menu, X } from "@lucide/astro";
import logoImage from "../../assets/logo/Aurasoli-logo.png";
import { primaryNavigation } from "../../data/navigation";
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";

const pathname = Astro.url.pathname;
const mobileNavId = "mobile-navigation";

function isActive(to: string): boolean {
  return to === "/"
    ? pathname === "/"
    : pathname === to || pathname.startsWith(`${to}/`);
}
---

<header class="site-header">
  <Container class="site-header__inner">
    <a href="/" class="brand-link" aria-label="Aurasoli, home">
      <Image
        class="brand-logo"
        src={logoImage}
        alt="Aurasoli"
        width={176}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="primary-nav" aria-label="Main navigation">
      <ul class="primary-nav__list">
        {
          primaryNavigation.map(({ label, to }) => (
            <li>
              <a
                href={to}
                class={isActive(to) ? "nav-link is-active" : "nav-link"}
                aria-current={isActive(to) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button to="/contact" variant="primary" class="nav-cta">
        Start a Project
      </Button>
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls={mobileNavId}
        aria-label="Open navigation menu"
        data-nav-toggle
      >
        <span class="nav-toggle__icon nav-toggle__icon--open" aria-hidden="true">
          <Menu size={22} />
        </span>
        <span class="nav-toggle__icon nav-toggle__icon--close" aria-hidden="true">
          <X size={22} />
        </span>
      </button>
    </div>
  </Container>
</header>

<div
  class="mobile-nav"
  id={mobileNavId}
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  hidden
  data-mobile-nav
>
  <div class="mobile-nav__panel">
    <nav aria-label="Mobile main navigation">
      <ul class="mobile-nav__list">
        {
          primaryNavigation.map(({ label, to }) => (
            <li>
              <a
                href={to}
                class={
                  isActive(to)
                    ? "mobile-nav__link is-active"
                    : "mobile-nav__link"
                }
                aria-current={isActive(to) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Button
      to="/contact"
      variant="primary"
      size="lg"
      fullWidth
      class="mobile-nav__cta"
    >
      Start a Project
    </Button>
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-mobile-nav]");

  if (toggle && panel) {
    const panelInner = panel.querySelector<HTMLElement>(".mobile-nav__panel");
    const focusableSelector =
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let previousOverflow = "";

    const focusable = () =>
      panelInner
        ? Array.from(panelInner.querySelectorAll<HTMLElement>(focusableSelector))
        : [];

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu",
      );

      if (open) {
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        focusable()[0]?.focus();
      } else {
        document.body.style.overflow = previousOverflow;
      }
    };

    const closeAndRestoreFocus = () => {
      setOpen(false);
      toggle.focus();
    };

    toggle.addEventListener("click", () => {
      setOpen(panel.hidden);
    });

    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a, button")) {
        setOpen(false);
      }
    });

    panelInner?.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") {
        return;
      }

      const items = focusable();
      if (items.length === 0) {
        return;
      }

      const first = items[0];
      const last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        closeAndRestoreFocus();
      }
    });
  }
</script>
