---
import { ArrowRight } from "@lucide/astro";
import Container from "../../layout/Container.astro";
import Button from "../../ui/Button.astro";
import ProjectCard from "../../ui/ProjectCard.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import { projects } from "../../../data/projects";
---

<section class="home-section home-section--alt" aria-labelledby="projects-title">
  <Container>
    <SectionHeader eyebrow="Selected Work" titleId="projects-title">
      <Fragment slot="title">
        Ideas Into <span class="hl">Digital Experiences.</span>
      </Fragment>
      <Fragment slot="description">
        Websites, an online store, an event experience, and an AI workflow —
        selected work that solves a clear, specific need.
      </Fragment>
    </SectionHeader>

    <ul class="projects-grid projects-grid--showcase">
      {
        projects.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>

    <p class="projects-note">
      Live sites are shown as captured from their public homepages. Case
      studies state only what is publicly verifiable.
    </p>

    <div class="section-actions">
      <Button to="/projects" variant="secondary">
        View all projects
        <ArrowRight size={18} aria-hidden="true" />
      </Button>
    </div>
  </Container>
</section>
