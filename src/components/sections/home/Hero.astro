---
import { ArrowRight } from "@lucide/astro";
import Container from "../../layout/Container.astro";
import Button from "../../ui/Button.astro";
import HeroVisual from "../../hero/HeroVisual.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <Container class="hero__inner">
    <div class="hero__content">
      <p class="eyebrow">Digital Solutions for Modern Businesses</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__title-line">Make Your</span>
        <span class="hero__title-line hl">Move.</span>
      </h1>
      <p class="hero__lead">
        We build digital solutions that help businesses develop their ideas,
        automate operations, and grow their digital presence.
      </p>
      <div class="hero__actions">
        <Button to="/contact" variant="primary" size="lg">
          Start a Project
          <ArrowRight size={18} aria-hidden="true" />
        </Button>
        <Button to="/services" variant="secondary" size="lg">
          Explore Services
        </Button>
      </div>
    </div>

    <HeroVisual />
  </Container>
</section>
