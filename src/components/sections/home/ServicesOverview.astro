---
import { ArrowRight, CodeXml } from "@lucide/astro";
import Container from "../../layout/Container.astro";
import Button from "../../ui/Button.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import { serviceIcons } from "../../../data/serviceIcons";
import { serviceCategories } from "../../../data/services";
---

<section class="home-section" aria-labelledby="services-title">
  <Container>
    <SectionHeader eyebrow="What We Do" titleId="services-title">
      <Fragment slot="title">
        Digital Solutions Built to{" "}
        <span class="hl">Move You Forward.</span>
      </Fragment>
      <Fragment slot="description">
        Aurasoli helps businesses build digital products, improve how they
        operate, and strengthen their online presence.
      </Fragment>
    </SectionHeader>

    <ul class="services-grid">
      {
        serviceCategories.map((category) => {
          const Icon = serviceIcons[category.slug] ?? CodeXml;

          return (
            <li class="service-card">
              <span class="service-card__icon" aria-hidden="true">
                <Icon size={22} stroke-width={1.75} />
              </span>
              <h3 class="service-card__title">{category.title}</h3>
              <p class="service-card__text">{category.description}</p>
              <a class="service-card__link" href={`/services#${category.slug}`}>
                Explore {category.title}
                <ArrowRight size={16} aria-hidden="true" />
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="section-actions">
      <Button to="/services" variant="secondary">
        Explore all services
        <ArrowRight size={18} aria-hidden="true" />
      </Button>
    </div>
  </Container>
</section>
