---
import Container from "../../layout/Container.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
---

<section class="page-hero" aria-labelledby="contact-hero-title">
  <Container>
    <div class="page-hero__inner">
      <p class="eyebrow">Contact Aurasoli</p>
      <SectionHeading as="h1" id="contact-hero-title" class="page-hero__title">
        Let's Talk About <span class="hl">Your Project.</span>
      </SectionHeading>
      <p class="page-hero__lead">
        Tell us what you're planning to build. Share your goals and requirements
        so we can understand how Aurasoli may help.
      </p>
    </div>
  </Container>
</section>
