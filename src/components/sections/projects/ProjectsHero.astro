---
import Container from "../../layout/Container.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
---

<section class="page-hero" aria-labelledby="projects-hero-title">
  <Container>
    <div class="page-hero__inner">
      <p class="eyebrow">Our Work</p>
      <SectionHeading as="h1" id="projects-hero-title" class="page-hero__title">
        Ideas Into <span class="hl">Digital Experiences.</span>
      </SectionHeading>
      <p class="page-hero__lead">
        Websites, online stores, event platforms, and AI workflows — a closer
        look at the work, the thinking behind it, and what each project sets out
        to do.
      </p>
    </div>
  </Container>
</section>
