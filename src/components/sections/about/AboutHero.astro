---
import { ArrowRight } from "@lucide/astro";
import Container from "../../layout/Container.astro";
import Button from "../../ui/Button.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
---

<section class="page-hero" aria-labelledby="about-hero-title">
  <Container>
    <div class="page-hero__inner">
      <p class="eyebrow">About Aurasoli</p>
      <SectionHeading as="h1" id="about-hero-title" class="page-hero__title">
        Technology With a <span class="hl">Purpose.</span>
      </SectionHeading>
      <p class="page-hero__lead">
        Aurasoli helps businesses turn ideas into digital solutions through
        software development, automation, marketing, and brand design.
      </p>
      <div class="page-hero__actions">
        <Button to="/services" variant="primary" size="lg">
          Explore Our Services
          <ArrowRight size={18} aria-hidden="true" />
        </Button>
      </div>
    </div>
  </Container>
</section>
