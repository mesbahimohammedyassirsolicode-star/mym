---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutHero from "../components/sections/about/AboutHero.astro";
import MissionStatement from "../components/sections/about/MissionStatement.astro";
import AboutServices from "../components/sections/about/AboutServices.astro";
import AboutApproach from "../components/sections/about/AboutApproach.astro";
import AboutValues from "../components/sections/about/AboutValues.astro";
import AboutClosingCta from "../components/sections/about/AboutClosingCta.astro";
import "../components/sections/about/about.css";
---

<BaseLayout
  title="About Aurasoli | Digital Solutions Partner for Business"
  description="Aurasoli is a digital solutions partner helping businesses build useful products, improve operations, strengthen their online presence, and unify their brand."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ]}
>
  <AboutHero />
  <MissionStatement />
  <AboutServices />
  <AboutApproach />
  <AboutValues />
  <AboutClosingCta />
</BaseLayout>
